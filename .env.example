# Houses 环境变量（复制为 .env 后填写）
APP_NAME=Houses
ENVIRONMENT=development
# AGPL-3.0：上线前填写公开源码仓库地址，页脚会显示「源代码」链接
SOURCE_CODE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

POSTGRES_HOST=localhost
POSTGRES_PORT=25432
POSTGRES_USER=houses
POSTGRES_PASSWORD=
POSTGRES_DATABASE=houses
POSTGRES_SSLMODE=disable

REDIS_HOST=localhost
REDIS_PORT=16379

# openssl rand -hex 32
JWT_SECRET_KEY=

# 首次启动创建超级管理员（库里已有超管则忽略）
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# AI 一键找房（OpenAI 兼容接口）
OPENAI_BASE_URL=
OPENAI_API_KEY=
CHAT_MODEL_NAME=

# 通知邮件中的房源链接前缀
PUBLIC_BASE_URL=http://127.0.0.1:5180
# 订阅通知邮件（留空则只有站内与浏览器通知）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# 房源图片目录（相对项目根目录）
UPLOAD_DIR=data/uploads
# 定时任务：租约状态每日推进、订阅匹配补偿（多实例部署时只在一个实例开启）
SCHEDULER_ENABLED=true
