# 复制为 deploy/.env.production 后填写；该文件含密钥，不要提交到仓库。
# 启动：docker compose --env-file deploy/.env.production up -d --build

ENVIRONMENT=production
APP_NAME=Houses
# AGPL-3.0 §13：必须填写公开的源码仓库地址，否则服务拒绝启动
SOURCE_CODE_URL=
# 对外访问地址（https），通知邮件里的链接与站点地图都会用到
PUBLIC_BASE_URL=https://houses.example.com
CORS_ALLOWED_ORIGINS=https://houses.example.com
WEB_PORT=8080
# 镜像版本（本地构建后 docker save 上传时用 git 短哈希做标签）
HOUSES_VERSION=latest
# 数据目录：留空用 Docker 命名卷；Docker 数据目录在慢盘上时，改成系统盘上的绝对路径
PG_DATA_DIR=
REDIS_DATA_DIR=
UPLOADS_DIR=

POSTGRES_USER=houses
POSTGRES_PASSWORD=
POSTGRES_DATABASE=houses
REDIS_PASSWORD=

# 至少 32 位随机串：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# 首次启动创建超级管理员，登录改密后可清空这两行
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# 高德地图（Web 端 JS API，可留空，留空时用 OpenStreetMap）。
# AMAP_KEY 会下发给浏览器；AMAP_SECURITY_CODE 只给 web 容器的 nginx 代理用，不会出现在前端。
# 记得在高德控制台把 Key 的域名白名单设成本站域名。
AMAP_KEY=
AMAP_SECURITY_CODE=

# AI 找房（OpenAI 兼容接口，可留空，留空时走规则解析）
OPENAI_BASE_URL=
OPENAI_API_KEY=
CHAT_MODEL_NAME=

# 订阅通知邮件（可留空）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

LOG_LEVEL=INFO
SCHEDULER_ENABLED=true
