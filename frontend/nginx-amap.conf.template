# 由 nginx 镜像启动时用 envsubst 渲染到 /etc/nginx/conf.d/amap.conf（http 级）。
# 高德 JS API 安全密钥只存在于服务器环境变量 AMAP_SECURITY_CODE，不进前端代码与仓库。
map $host $amap_jscode {
    default "${AMAP_SECURITY_CODE}";
}

# 高德服务接口多用 JSONP（带 callback 参数），上游却返回 application/json；
# 站点开了 nosniff，浏览器会拒绝执行，所以代理时按是否带 callback 改写类型。
map $arg_callback $amap_content_type {
    ""      "application/json; charset=utf-8";
    default "application/javascript; charset=utf-8";
}
